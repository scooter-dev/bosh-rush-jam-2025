[sub_resource type="GDScript" id="GDScript_ch2c7"]
script/source = "extends Area3D



func _on_body_entered(body: Node3D) -> void:
	if body is Player:
		body.levelTransition(\"res://Scenes/Maps/SafeRoom/SafeRoom.tscn\")
"

