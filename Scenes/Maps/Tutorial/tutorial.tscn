size = Vector3(3.4, 2, 5)

[sub_resource type="GDScript" id="GDScript_o5w3y"]
script/source = "extends Area3D


func _ready() -> void:
	body_entered.connect(onBodyEntered)
	
@export var door_4: Door

func onBodyEntered(body : Node3D) -> void:
	if body is GrabbableProp:
		if body.linear_velocity.length_squared() > 25.0:
			print(\"unlocked\")
			door_4.unlock()
"

[sub_resource type="BoxShape3D" id="BoxShape3D_o5w3y"]
size = Vector3(2, 2.6, 0.7)

[sub_resource type="GDScript" id="GDScript_5snpj"]
script/source = "extends Node

@export var zombie: Zombie
@export var door : Door
@export var tutorialChange : Node3D
@export_multiline var newText : String

func _ready() -> void:
	zombie.dead.connect(onZDead)

func onZDead() -> void:
	door.unlock()
	tutorialChange.text = newText


func _on_player_chair_damaged() -> void:
	if PlayerManager.health < 5:
		zombie.damage = 0
"

[sub_resource type="PhysicsMaterial" id="PhysicsMaterial_ch2c7"]
