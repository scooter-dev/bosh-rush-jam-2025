; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Spin of the Dead"
run/main_scene="uid://d2a1pvu2l8nt4"
config/features=PackedStringArray("4.4", "Forward Plus")
run/max_fps=120
config/icon="uid://dhma06nv4bcls"

[autoload]

OptionsManager="*res://SRC/Singletons/OptionsManager.gd"
PlayerInput="*res://SRC/Singletons/PlayerInput.gd"
MultiplayerManager="*res://SRC/Singletons/MultiplayerManager.gd"
WorldManager="*res://SRC/Singletons/WorldManager.gd"
PlayerManager="*res://SRC/Singletons/PlayerManager.gd"
Dialogic="*res://addons/dialogic/Core/DialogicGameHandler.gd"

[dialogic]

directories/dch_directory={
"janitor": "res://SRC/Dialogic/janitor.dch"
}
directories/dtl_directory={
"JanitorTalk": "res://SRC/Dialogic/JanitorTalk.dtl"
}
variables={
"FirstJanitor": true
}

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/vsync/vsync_mode=0

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg", "res://addons/lightmap_probe_grid/plugin.cfg")

