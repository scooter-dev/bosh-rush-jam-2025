[gd_resource type="Shader" format=3 uid="uid://cl251maua5v7a"]

[resource]
code = "// NOTE: Shader automatically converted from Godot Engine 4.4.beta1's StandardMaterial3D.

shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx, unshaded;

uniform vec4 emptyColor : source_color = vec4(1);
uniform vec4 fullColor : source_color = vec4(1,0,0,1);
uniform float fill : hint_range(0.0, 1.0, 0.01) = 0.5;

void vertex() {
	// Billboard Mode: Enabled
	MODELVIEW_MATRIX = VIEW_MATRIX * mat4(
			MAIN_CAM_INV_VIEW_MATRIX[0],
			MAIN_CAM_INV_VIEW_MATRIX[1],
			MAIN_CAM_INV_VIEW_MATRIX[2],
			MODEL_MATRIX[3]);
	MODELVIEW_NORMAL_MATRIX = mat3(MODELVIEW_MATRIX);
}

void fragment() {
	ALBEDO = mix(emptyColor.rgb, fullColor.rgb, float(fill > UV.x));
}
"
