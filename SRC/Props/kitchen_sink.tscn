[sub_resource type="GDScript" id="GDScript_7v0ia"]
script/source = "extends MeshInstance3D


@export var ray_cast_3d: RayCast3D
@export var leak: CPUParticles3D
@export var audio: AudioStreamPlayer3D

func _process(delta: float) -> void:
	leak.emitting = ray_cast_3d.get_collider() == null
	if leak.emitting:
		if !audio.playing:
			audio.play()
	else:
		audio.stop()
"

